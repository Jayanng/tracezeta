# TraceZeta — configuration (copy to .env and fill in; never commit .env)
#
# 1) neatlogs — create a project at https://app.neatlogs.com
#    NEATLOGS_WRITE_KEY is the project ingest key (ti_...)
#    NEATLOGS_PROJECT_ID is the project UUID from the project settings page
NEATLOGS_WRITE_KEY=
NEATLOGS_PROJECT_ID=

# 2) Crustdata — https://crustdata.com (7 of the 11 target tools hit its live API)
#    The API key arrives through a one-time masked-entry page.
CRUSTDATA_API_KEY=

# Not in .env, configured separately (both optional for the core loop):
#   entire  — `entire` CLI login (checkpoints + trails). Already-logged-in works out of the box.
#   agy     — Antigravity CLI login (used only by the Medic sandbox repair step).
